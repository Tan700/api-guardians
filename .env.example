# Optional: set this on your local machine to enable AI-generated repair proposals.
# Keep real secrets in .env.local. Never commit .env.local to GitHub.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-6-sol in the current implementation.
OPENAI_MODEL=gpt-6-sol

# Optional: local-only GitHub write access for creating draft PRs.
# Create a fine-grained token with Contents (read/write), Pull requests (read/write),
# Checks (read), and Metadata (read-only) permissions for only the test repository.
# Never commit .env.local, expose this endpoint publicly, or paste the token into the UI.
GITHUB_TOKEN=

# Required for actual PR creation: comma-separated exact owner/repo allowlist.
# Example: your-github-name/api-guardian-shipping-test
# Dry-run patch validation works without these GitHub settings.
GITHUB_ALLOWED_REPOS=

# Milestone 06: GITHUB_TOKEN also needs Checks (read) to display PR CI results.
